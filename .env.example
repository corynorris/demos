# demos.corynorris.me — copy to .env and fill in. Do NOT commit .env.
# Run ./scripts/gen-prod-env.sh to generate a production .env with
# auto-generated secrets.

# ===================
# PostgreSQL (shared server — DBs: spaced_repetition, comments, url_shortener, trello)
# WARNING: POSTGRES_PASSWORD is baked into the volume on first boot.
# Do NOT change it after the first successful deploy.
# ===================
POSTGRES_USER=demos
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ===================
# URL Shortener
# ===================
# BASE_URL=https://demos.corynorris.me/s

# ===================
# Spaced Repetition (SvelteKit + better-auth)
# Override if your PG password differs from POSTGRES_PASSWORD above.
# Default: postgres://demos:demos@db:5432/spaced_repetition
# ===================
# DATABASE_URL=postgres://demos:CHANGE_ME@db:5432/spaced_repetition
# BETTER_AUTH_URL=http://localhost/srs
# BETTER_AUTH_SECRET=CHANGE_ME_32_byte_hex

# ===================
# Public domain
# ===================
# DOMAIN=demos.corynorris.me
